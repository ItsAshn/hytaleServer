# ===========================================================================
# Hytale server configuration — copy to .env and adjust.
#   cp .env.example .env
# ===========================================================================

# --- Server basics ---------------------------------------------------------
MEMORY=4G                 # JVM heap (min = max). 4G min, 8G+ recommended.
SERVER_PORT=5520          # UDP port (QUIC). Must match your router forward.
SERVER_NAME=Hytale Server
MOTD=
MAX_PLAYERS=20
MAX_VIEW_RADIUS=12        # Biggest RAM driver; default 32 is heavy for home use.
GAME_MODE=Adventure
WORLD_NAME=default

# --- Download / updates ----------------------------------------------------
PATCHLINE=release         # release | pre-release
DOWNLOAD_ON_START=true    # Check for and apply server updates on every start.

# --- Auth ------------------------------------------------------------------
# On the very first start, watch `docker compose logs -f` for a device-login
# URL + code and confirm it with your Hytale account. Afterwards auth is
# persisted (encrypted against the stable machine-id in the data volume) and
# restarts are fully headless.
AUTH_MODE=authenticated   # authenticated | insecure | offline
AUTO_AUTH=true            # Automatically drive /auth login + /auth persistence.
AUTH_PERSISTENCE=Encrypted
AUTH_SELECT_PROFILE=1     # Which profile to pick if your account has several.

# --- JVM tuning ------------------------------------------------------------
USE_AOT_CACHE=true        # Use the shipped HytaleServer.aot startup cache.
JVM_ARGS=                 # Extra JVM flags, e.g. "-XX:+UseG1GC -XX:MaxGCPauseMillis=200"
EXTRA_ARGS=               # Extra server flags, e.g. "--disable-sentry --backup"

# --- Container user --------------------------------------------------------
PUID=1000                 # Match your host user so ./data stays writable.
PGID=1000

# ===========================================================================
# Dynamic DNS (the fix for your non-static IP) — only used by the optional
# ddns-updater sidecar:  docker compose --profile ddns up -d
# Players connect to  <DDNS_HOSTNAME>:5520  instead of your raw IP.
# ===========================================================================

DDNS_PROVIDER=duckdns     # duckdns | noip | cloudflare | custom | manual

# duckdns: create a free subdomain + token at https://www.duckdns.org
DDNS_HOSTNAME=myserver.duckdns.org
DDNS_TOKEN=

# noip: your no-ip.com account credentials
DDNS_USERNAME=
DDNS_PASSWORD=

# cloudflare: use your own domain (e.g. play.example.com) hosted on Cloudflare.
#   DDNS_HOSTNAME: record(s) to update — comma-separate several, e.g.
#                  "play.example.com,example.com"
#   DDNS_ZONE_NAME: your domain/zone, e.g. "example.com"
#   DDNS_API_TOKEN: an API token with Zone.DNS "Edit" permission for that zone
#                   (https://dash.cloudflare.com/profile/api-tokens)
#DDNS_API_TOKEN=
#DDNS_ZONE_NAME=example.com
#DDNS_TTL=1               # 1 = "auto"
#DDNS_PROXIED=false       # must stay false — the game needs direct UDP 5520

# custom: any update URL; {IP} is replaced with the detected public IP
DDNS_UPDATE_URL=

# manual: no automatic updates — the sidecar prints your current public IP so
# you can create the A record yourself (useful for other DNS hosts or a
# static IP), then exits. Remove --profile ddns afterwards.

DDNS_INTERVAL=300         # Seconds between public-IP checks.

# ===========================================================================
# Caddy — serve your own domain WITHOUT a Cloudflare API token.
#   docker compose --profile caddy up -d
# Use this instead of the cloudflare DDNS provider when your domain's DNS is
# not on Cloudflare (or you don't want to create an API token). Point an
# A/AAAA record for CADDY_DOMAIN at this host's public IP (the ddns "manual"
# provider prints it), then Caddy handles the TLS certificate automatically
# via the HTTP-01 challenge. Players still connect to <CADDY_DOMAIN>:5520.
# ===========================================================================

CADDY_DOMAIN=play.example.com

# Port Caddy listens on for HTTP (certificate issuance/renewal). MUST be
# reachable from the internet. Change it here if port 80 is already taken on
# this host — and forward that port on your router accordingly.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
